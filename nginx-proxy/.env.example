# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
# Keep comments on their own lines (an inline comment after an empty value becomes the value).

# ---- general ---------------------------------------------------------------
# What the browser uses; must match the redirect URIs registered at Google and Okta
PUBLIC_BASE_URL=http://localhost
SERVER_NAME=localhost
NGINX_PORT=80
# Set to true when serving over HTTPS
COOKIE_SECURE=false
GATEWAY_UPSTREAM=host.docker.internal:8080
UI_DIST=../frontend/dist/storefront/browser
OAUTH2_PROXY_VERSION=v7.15.0

# ---- customers: Google (see README "Google sign-in setup") -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64:
#   python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
CUSTOMER_COOKIE_SECRET=

# ---- admins: Okta (see ../okta-login-setup/README.md) ----------------------
# Your Okta domain without https://, e.g. integrator-1234567.okta.com
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ADMIN_GROUP=smd-admins
# Must be a DIFFERENT random value from CUSTOMER_COOKIE_SECRET
ADMIN_COOKIE_SECRET=
